APP_NAME="Nurul Hikmah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nurul_hikmah
DB_USERNAME=nurul_hikmah
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=gmail
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional SMTP fallback (not used when MAIL_MAILER=gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000

# Google OAuth (admin login) — set Authorized redirect URI in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/admin/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Gmail send OAuth (reuse CLIENT_ID/SECRET; add this redirect URI in Google Cloud Console)
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/admin/gmail/oauth/callback
# Optional: paste refresh token here after connect (also stored encrypted in storage/app/private/gmail-oauth.json)
GOOGLE_GMAIL_REFRESH_TOKEN=

VITE_APP_NAME="${APP_NAME}"
